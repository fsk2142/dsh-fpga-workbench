{
  "name": "dsh-fpga-workbench",
  "version": "1.6.0",
  "description": "FPGA 开发模式 + 工具链设置:一个 DSH agent 预设(人设/工具/技能 + 本机工具链提示),外加「插件 → dsh-fpga-workbench → 配置」里配置 Vivado / ModelSim / QuestaSim / Verilator 与仿真库映射文件,以及可选的 AMD Vivado MCP 接入与版本检查。",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "author": "fsk2142",
  "homepage": "https://github.com/fsk2142/dsh-fpga-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsk2142/dsh-fpga-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/fsk2142/dsh-fpga-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "fpga",
    "vivado",
    "modelsim",
    "verilator",
    "mcp",
    "agent-preset"
  ],
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mode": {
      "types": "./lib/mode.d.ts",
      "default": "./lib/mode.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets/fpga-workbench/skills",
    "presets/fpga-workbench/templates",
    "presets/fpga-workbench/tools",
    "presets/fpga-workbench/workspace",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node tools/check-all.mjs",
    "test:installed": "node tools/check-all.mjs --installed",
    "test:safety": "node tools/check-all.mjs --safety",
    "test:vivado": "node tools/check-all.mjs --vivado",
    "privacy:history": "node tools/check-privacy-history.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "//compatibility": "仅供市场展示，**不影响加载**。宿主 app-boot 的 unmetRequirements() 只读 engines.dsh（有它时 peerDependencies 全部忽略）；没有 engines.dsh 才逐个匹配 peer。所以 dsh / dshReleases / 两条 peer 四处写同一个 range，改一处就要四处一起改。注意宿主判定带 includePrerelease，见 tools/lib/version-range.mjs 的说明。",
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
