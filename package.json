{
  "name": "dsh-fpga-workbench",
  "version": "0.6.0",
  "description": "FPGA 开发模式 + 工具链设置:一个 DSH agent 预设(人设/工具/技能 + 本机工具链提示),外加「设置 → FPGA 开发模式」里配置 Vivado / ModelSim / QuestaSim / Verilator 与仿真库映射文件,以及可选的 AMD Vivado MCP 接入与版本检查。",
  "license": "MIT",
  "author": "dsh-fpga-workbench contributors",
  "homepage": "https://github.com/fsk2142/dsh-fpga-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsk2142/dsh-fpga-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/fsk2142/dsh-fpga-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "fpga",
    "vivado",
    "modelsim",
    "verilator",
    "mcp",
    "agent-preset"
  ],
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./mode": "./lib/mode.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets/fpga-workbench/skills",
    "presets/fpga-workbench/templates",
    "presets/fpga-workbench/tools",
    "presets/fpga-workbench/workspace",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "test": "node tools/check-all.mjs",
    "test:installed": "node tools/check-all.mjs --installed",
    "test:safety": "node tools/check-all.mjs --safety",
    "test:vivado": "node tools/check-all.mjs --vivado"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "compatibility": {
      "dsh": "0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.2",
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
